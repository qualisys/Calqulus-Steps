{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "calqulus-steps",
  "sourceRoot": "libs/calqulus-steps",
  "projectType": "library",
  "targets": {
    "build-metadata": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node bin/build-metadata.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
          "node ../../node_modules/typescript/bin/tsc -p tsconfig.module.json"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/build"],
      "dependsOn": ["build-metadata"]
    },
    "build:main": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/build/main"]
    },
    "build:module": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.module.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/build/module"],
      "dependsOn": ["build:main"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/nyc --silent ../../node_modules/.bin/ava",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build:main"]
    }
  },
  "tags": []
}
