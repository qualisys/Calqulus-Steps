{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "calqulus-steps",
  "sourceRoot": "libs/calqulus-steps",
  "projectType": "library",
  "targets": {
    "build-metadata": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node bin/build-metadata.js --production",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{projectRoot}/build-metadata.ts",
        "{workspaceRoot}/libs/calqulus/build-metadata.ts",
        "{workspaceRoot}/apps/calqulus-toolbelt/build-metadata.ts"
      ],
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run calqulus-steps:build:main",
          "nx run calqulus-steps:build:module"
        ],
        "parallel": false
      },
      "outputs": ["{projectRoot}/build"],
      "cache": true,
    },
    "build:main": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/build/main",
        "main": "{projectRoot}/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.json",
        "assets": []
      }
    },
    "build:module": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/build/module",
        "main": "{projectRoot}/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.module.json",
        "assets": []
      },
      "dependsOn": ["build:main"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/nyc --silent ../../node_modules/.bin/ava",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build:main"]
    },
    "cov:html": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/nyc report --reporter=html",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/coverage"],
      "dependsOn": ["test:unit"]
    },
    "cov:lcov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/nyc report --reporter=lcov",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/coverage"],
      "dependsOn": ["test:unit"]
    },
    "cov:open": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open {projectRoot}/coverage/index.html",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["cov:html"]
    }
  },
  "tags": []
}
