{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "calqulus-steps",
  "sourceRoot": "libs/calqulus-steps",
  "projectType": "library",
  "targets": {
    "build-metadata": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node bin/build-metadata.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run calqulus-steps:build:main",
          "nx run calqulus-steps:build:module"
        ],
        "parallel": false
      },
      "outputs": ["{projectRoot}/build"],
      "dependsOn": ["build-metadata"]
    },
    "build:main": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/build/main",
        "main": "{projectRoot}/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.json",
        "assets": []
      }
    },
    "build:module": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/build/module",
        "main": "{projectRoot}/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.module.json",
        "assets": []
      },
      "dependsOn": ["build:main"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/nyc --silent ../../node_modules/.bin/ava",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build:main"]
    }
  },
  "tags": []
}
